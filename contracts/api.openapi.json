{
  "components": {
    "schemas": {
      "ArtifactResponse": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "parent_sha": {
            "title": "Parent Sha",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "sha256",
          "bytes",
          "parent_sha"
        ],
        "title": "ArtifactResponse",
        "type": "object"
      },
      "CapabilityRequest": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "capability": {
            "enum": [
              "get_capture_metadata",
              "assess_capture_quality",
              "list_protocols",
              "list_endpoints",
              "list_conversations",
              "analyze_dns",
              "analyze_tcp_establishment",
              "analyze_tcp_health",
              "analyze_rtt",
              "analyze_window_behavior",
              "analyze_tcp_resets",
              "analyze_throughput",
              "analyze_mss",
              "analyze_fragmentation",
              "analyze_pmtud_signals",
              "analyze_tls_handshakes"
            ],
            "maxLength": 64,
            "title": "Capability",
            "type": "string"
          },
          "tcp_stream": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tcp Stream"
          }
        },
        "required": [
          "artifact_id",
          "capability"
        ],
        "title": "CapabilityRequest",
        "type": "object"
      },
      "CaseResponse": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactResponse"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "capture_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Sha"
          },
          "created": {
            "title": "Created",
            "type": "string"
          },
          "evidence_count": {
            "title": "Evidence Count",
            "type": "integer"
          },
          "gate_boundary": {
            "title": "Gate Boundary",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryResponse"
            },
            "title": "History",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "original_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Id"
          },
          "provider_mode": {
            "title": "Provider Mode",
            "type": "string"
          },
          "quality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunResponse"
            },
            "title": "Runs",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "symptom": {
            "title": "Symptom",
            "type": "string"
          },
          "updated": {
            "title": "Updated",
            "type": "string"
          }
