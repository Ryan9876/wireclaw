            "type": "string",
            "title": "Artifact Id"
          },
          "parent_sha256": {
            "type": "string",
            "title": "Parent Sha256"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "related_finding_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related Finding Ids"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
