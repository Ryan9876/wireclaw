        "properties": {
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "provenance": {
            "$ref": "#/components/schemas/EvidenceCaptureProvenance"
