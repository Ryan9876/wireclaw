          "kind",
          "sha256",
          "bytes",
          "parent_sha"
        ],
        "title": "ArtifactResponse"
      },
      "BridgeGrantRequest": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Artifact Id"
          },
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "title": "Finding Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_id",
          "finding_id"
        ],
        "title": "BridgeGrantRequest"
      },
      "BridgeGrantResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "token": {
            "type": "string",
            "title": "Token"
          },
          "bridge_origin": {
            "type": "string",
            "title": "Bridge Origin"
          },
          "expires_unix": {
            "type": "integer",
            "title": "Expires Unix"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "token",
          "bridge_origin",
          "expires_unix"
        ],
        "title": "BridgeGrantResponse"
      },
      "CapabilityRequest": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Artifact Id"
          },
          "capability": {
            "type": "string",
            "enum": [
              "get_capture_metadata",
              "assess_capture_quality",
              "list_protocols",
              "list_endpoints",
              "list_conversations",
              "analyze_dns",
              "analyze_tcp_establishment",
              "analyze_tcp_health",
              "analyze_rtt",
              "analyze_window_behavior",
              "analyze_tcp_resets",
              "analyze_throughput",
              "analyze_mss",
              "analyze_fragmentation",
              "analyze_pmtud_signals",
              "analyze_tls_handshakes"
            ],
            "maxLength": 64,
            "title": "Capability"
          },
          "tcp_stream": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tcp Stream"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_id",
          "capability"
        ],
        "title": "CapabilityRequest"
      },
      "CaseResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "symptom": {
            "type": "string",
            "title": "Symptom"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "created": {
            "type": "string",
            "title": "Created"
          },
          "updated": {
            "type": "string",
            "title": "Updated"
          },
          "capture_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Sha"
          },
          "original_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Id"
          },
          "quality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryResponse"
            },
            "type": "array",
            "title": "History"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunResponse"
            },
            "type": "array",
            "title": "Runs"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactResponse"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "evidence_count": {
            "type": "integer",
            "title": "Evidence Count"
          },
          "gate_boundary": {
            "type": "string",
            "title": "Gate Boundary"
          },
          "provider_mode": {
            "type": "string",
            "title": "Provider Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "symptom",
          "state",
          "created",
          "updated",
          "capture_sha",
          "original_id",
          "quality",
          "last_error",
          "history",
          "runs",
          "artifacts",
          "evidence_count",
          "gate_boundary",
          "provider_mode"
        ],
        "title": "CaseResponse"
      },
      "CreateCase": {
        "properties": {
          "symptom": {
            "type": "string",
            "maxLength": 4096,
            "title": "Symptom"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symptom"
        ],
        "title": "CreateCase"
      },
